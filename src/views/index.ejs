<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
  <div>
    <h1 class="h4 mb-0 fw-bold d-flex align-items-center gap-2">
      <i class="bi bi-speedometer2 text-warning"></i> Centro de Operaciones
    </h1>
    <span class="text-secondary small">Supervisión y control diario de personal y obras</span>
  </div>
  <div class="badge bg-body-secondary border border-secondary-subtle px-3 py-2 text-body-secondary d-flex align-items-center gap-2">
    <i class="bi bi-calendar3 text-warning"></i>
    <span>Jornada de hoy: <strong class="text-body-emphasis"><%= hoy %></strong></span>
  </div>
</div>

<!-- AVISO DE ALERTAS PRL / CAE SI EXISTEN -->
<% if (typeof alertasCaeCount !== 'undefined' && alertasCaeCount > 0) { %>
<div class="alert alert-warning border-0 shadow-sm d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2 py-2 px-3" style="background: rgba(245, 158, 11, 0.15); border-left: 4px solid #f59e0b !important;">
  <div class="d-flex align-items-center gap-2 text-warning">
    <i class="bi bi-shield-exclamation fs-4"></i>
    <div>
      <strong><%= alertasCaeCount %> <%= alertasCaeCount === 1 ? 'alerta' : 'alertas' %> de PRL / CAE detectadas</strong>
      <div class="small text-secondary">Existen documentos de trabajadores o empresas vencidos o próximos a vencer en los siguientes 15 días.</div>
    </div>
  </div>
  <a href="/cae/alertas" class="btn btn-warning btn-sm text-dark fw-bold">
    Revisar documentación <i class="bi bi-arrow-right"></i>
  </a>
</div>
<% } %>

<!-- TARJETAS KPI DE ACTIVIDAD -->
<div class="row g-3 mb-4">
  <% stats.forEach(function(s) { var ico=s[0], col=s[1], val=s[2], lab=s[3]; %>
  <div class="col-6 col-md-3">
    <div class="card h-100 shadow-sm border-secondary-subtle">
      <div class="card-body p-3 d-flex align-items-center gap-3">
        <div class="fs-1 text-<%= col %> d-flex align-items-center justify-content-center rounded-3 bg-body-tertiary p-2" style="width: 52px; height: 52px;">
          <i class="bi bi-<%= ico %>"></i>
        </div>
        <div>
          <div class="fs-4 fw-bold font-monospace mb-0 lh-1"><%= val %></div>
          <small class="text-secondary text-uppercase fw-semibold" style="font-size: 0.72rem;"><%= lab %></small>
        </div>
      </div>
    </div>
  </div>
  <% }); %>
</div>

<!-- SECCIÓN PARTES DE HOY -->
<div class="d-flex justify-content-between align-items-center mb-3">
  <div class="sec mb-0 border-0 p-0 fs-6">
    <i class="bi bi-calendar-check text-warning me-1"></i> Partes diarios de hoy (<%= hoy %>)
  </div>
  <a href="/obras/nueva" class="btn btn-sm btn-outline-secondary py-1 px-2">
    <i class="bi bi-plus-lg"></i> Nueva obra
  </a>
</div>

<div class="row g-3">
<% if (obras.length === 0) { %>
  <div class="col-12">
    <div class="card p-4 text-center border-dashed">
      <i class="bi bi-building fs-1 text-secondary mb-2"></i>
      <h5 class="fw-semibold">No hay obras activas</h5>
      <p class="text-secondary small mb-3">Crea tu primera obra para comenzar a registrar partes de horas y documentación.</p>
      <div><a href="/obras/nueva" class="btn btn-opl btn-sm"><i class="bi bi-plus-circle"></i> Crear obra</a></div>
    </div>
  </div>
<% } %>

<% obras.forEach(function(ob) { 
     const dh = ob.diario_hoy;
     const tienePersonal = dh && dh.personal_hoy > 0;
     const totalHoras = dh ? dh.horas_hoy : 0;
%>
<div class="col-md-6 col-xl-4">
  <div class="card h-100 shadow-sm border-secondary-subtle">
    <div class="card-body p-3 d-flex flex-column justify-content-between">
      <div>
        <div class="d-flex justify-content-between align-items-start mb-2 gap-2">
          <div>
            <h5 class="h6 fw-bold mb-1 text-body-emphasis"><%= ob.nombre %></h5>
            <span class="badge bg-secondary font-monospace" style="font-size: 0.7rem;"><%= ob.codigo %></span>
          </div>
          <% if (tienePersonal) { %>
            <span class="badge bg-success-subtle text-success border border-success-subtle" title="Parte con personal fichado">
              <i class="bi bi-record-circle-fill text-success me-1"></i> En marcha
            </span>
          <% } else if (dh) { %>
            <span class="badge bg-warning-subtle text-warning border border-warning-subtle" title="Parte abierto pero sin operarios">
              <i class="bi bi-clock me-1"></i> Abierto (0h)
            </span>
          <% } else { %>
            <span class="badge bg-body-tertiary text-body-secondary border border-secondary-subtle" title="Aún no se ha registrado parte para hoy">
              Pendiente
            </span>
          <% } %>
        </div>

        <% if (ob.descripcion) { %>
          <p class="text-secondary small mb-3 text-truncate" title="<%= ob.descripcion %>"><%= ob.descripcion %></p>
        <% } else { %>
          <p class="text-muted small mb-3 fst-italic">Sin descripción detallada.</p>
        <% } %>

        <div class="bg-body-tertiary p-2 rounded-2 mb-3 d-flex justify-content-around text-center border border-secondary-subtle">
          <div>
            <span class="small text-secondary d-block" style="font-size: 0.7rem;">Operarios hoy</span>
            <strong class="font-monospace fs-6 text-body-emphasis"><%= dh ? dh.personal_hoy : 0 %></strong>
          </div>
          <div class="border-end border-secondary-subtle"></div>
          <div>
            <span class="small text-secondary d-block" style="font-size: 0.7rem;">Horas registradas</span>
            <strong class="font-monospace fs-6 text-warning"><%= dh ? (totalHoras % 1 === 0 ? totalHoras : totalHoras.toFixed(2)) + 'h' : '0h' %></strong>
          </div>
        </div>
      </div>

      <div class="d-flex gap-2">
        <a href="/diario/<%= ob.id_obra %>/<%= hoy %>" class="btn btn-opl btn-sm flex-grow-1">
          <i class="bi bi-calendar-day"></i> <%= dh ? 'Ver parte de hoy' : 'Abrir parte de hoy' %>
        </a>
        <a href="/obra/<%= ob.id_obra %>/documentacion" class="btn btn-outline-secondary btn-sm" title="Documentación y planos">
          <i class="bi bi-folder2-open"></i>
        </a>
      </div>
    </div>
  </div>
</div>
<% }); %>
</div>
