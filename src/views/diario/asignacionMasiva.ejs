<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
  <div>
    <h2 class="h4 mb-0"><i class="bi bi-people-fill text-success"></i> Asignación masiva — <%= obra.nombre %></h2>
    <small class="text-muted"><i class="bi bi-calendar3"></i> <%= d.fecha %> &bull; <span class="badge bg-secondary"><%= obra.codigo %></span></small>
  </div>
  <a href="/diario/<%= obra.id_obra %>/<%= d.fecha %>" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i> Volver al parte diario</a>
</div>

<div class="alert alert-info small py-2 mb-3">
  <i class="bi bi-info-circle-fill"></i>
  Asigna o actualiza la misma jornada (horas, partida y asunto) a múltiples trabajadores de una empresa a la vez.
  Si un trabajador ya está en el parte, se actualizará su jornada automáticamente.
</div>

<div class="card shadow-sm mb-3">
  <div class="card-header bg-dark fw-bold">Configuración de la jornada común</div>
  <div class="card-body">
    <form method="post" id="form-asignacion-masiva">
      <div class="row g-2 align-items-end mb-3">
        <div class="col-md-3">
          <label class="form-label small mb-1 fw-bold">Empresa *</label>
          <select name="id_empresa" id="am-emp" class="form-select form-select-sm" required autofocus>
            <option value="">— Selecciona empresa —</option>
            <% emps_obra.forEach(function(e) { %>
              <option value="<%= e.id_empresa %>" <%= emps_obra.length === 1 ? 'selected' : '' %>><%= e.nombre %></option>
            <% }); %>
          </select>
        </div>
        <div class="col-md-2">
          <label class="form-label small mb-1 fw-bold">Horas comunes *</label>
          <input type="number" name="horas" class="form-control form-control-sm" value="8" step="0.25" min="0" max="24" required>
        </div>
        <div class="col-md-3">
          <label class="form-label small mb-1">Partida común</label>
          <select name="id_partida" class="form-select form-select-sm">
            <option value="">— Partida general —</option>
            <% partidas.forEach(function(p) { %>
              <option value="<%= p.id_partida %>"><%= p.codigo %> <%= p.descripcion %></option>
            <% }); %>
          </select>
        </div>
        <div class="col-md-4">
          <label class="form-label small mb-1">Asunto común</label>
          <input type="text" name="asunto" class="form-control form-control-sm" placeholder="Trabajos realizados...">
        </div>
      </div>

      <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
        <label class="form-label small mb-0 fw-bold">Selección de personal</label>
        <div class="d-flex gap-2 align-items-center">
          <input type="text" id="filtro-personas" class="form-control form-control-sm py-0" style="width:200px" placeholder="Buscar por nombre/DNI...">
          <button type="button" class="btn btn-outline-secondary btn-sm py-0" id="btn-marcar-todos"><i class="bi bi-check-all"></i> Todos</button>
          <button type="button" class="btn btn-outline-secondary btn-sm py-0" id="btn-desmarcar-todos"><i class="bi bi-dash"></i> Ninguno</button>
        </div>
      </div>

      <div id="am-personas" class="border rounded p-3 mb-3 bg-dark" style="max-height:360px;overflow-y:auto">
        <% emps_obra.forEach(function(e) {
           var pers = pers_x_emp[e.id_empresa] || []; %>
          <div class="am-grp" data-emp="<%= e.id_empresa %>" style="display:none">
            <% if (pers.length === 0) { %>
              <p class="text-muted small mb-0">Sin personas activas en esta empresa.</p>
            <% } %>
            <div class="row g-2">
              <% pers.forEach(function(p) { 
                 const yaHoras = mapa_existentes ? mapa_existentes[p.id_persona + '_' + e.id_empresa] : undefined;
              %>
                <div class="col-md-6 item-persona" data-busqueda="<%= (p.apellido1 + ' ' + (p.apellido2||'') + ' ' + p.nombre + ' ' + p.dni).toLowerCase() %>">
                  <div class="form-check p-2 border border-secondary rounded bg-body-tertiary">
                    <input class="form-check-input ms-1 me-2" type="checkbox" name="personas" value="<%= p.id_persona %>"
                           id="am-p<%= p.id_persona %>" disabled>
                    <label class="form-check-label small d-block" for="am-p<%= p.id_persona %>">
                      <strong><%= [p.apellido1, p.apellido2].filter(Boolean).join(' ') %>, <%= p.nombre %></strong>
                      <% if (yaHoras !== undefined) { %>
                        <span class="badge bg-primary ms-1" style="font-size:0.65rem"><i class="bi bi-check2"></i> En parte (<%= hhmm(yaHoras) %>)</span>
                      <% } %>
                      <br>
                      <span class="text-muted font-monospace" style="font-size:0.75rem"><%= p.dni %></span>
                      <% if (p.oficio) { %> <span class="badge bg-secondary ms-1" style="font-size:0.65rem"><%= p.oficio %></span><% } %>
                    </label>
                  </div>
                </div>
              <% }); %>
            </div>
          </div>
        <% }); %>
        <p class="text-muted small mb-0 text-center py-3" id="am-hint"><i class="bi bi-arrow-up"></i> Selecciona una empresa en el desplegable superior para ver el personal disponible.</p>
      </div>

      <div class="d-flex gap-2">
        <button type="submit" class="btn btn-opl btn-sm fw-bold"><i class="bi bi-check2-all"></i> Asignar / Guardar seleccionados</button>
        <a href="/diario/<%= obra.id_obra %>/<%= d.fecha %>" class="btn btn-secondary btn-sm">Cancelar</a>
      </div>
    </form>
  </div>
</div>

<script>
function actualizarGrupoEmpresa() {
  const empVal = document.getElementById('am-emp').value;
  document.querySelectorAll('.am-grp').forEach(function(g){
    const on = g.dataset.emp === empVal;
    g.style.display = on ? 'block' : 'none';
    g.querySelectorAll('input[type=checkbox]').forEach(function(cb){ 
      cb.disabled = !on; 
      if(!on) cb.checked = false; 
    });
  });
  document.getElementById('am-hint').style.display = empVal ? 'none' : 'block';
}

document.getElementById('am-emp').addEventListener('change', actualizarGrupoEmpresa);

// Disparar en arranque por si viene preseleccionada o solo hay una
actualizarGrupoEmpresa();

document.getElementById('btn-marcar-todos').addEventListener('click', function(){
  const empVal = document.getElementById('am-emp').value;
  if (!empVal) return;
  const grp = document.querySelector('.am-grp[data-emp="' + empVal + '"]');
  if (grp) {
    grp.querySelectorAll('.item-persona:not([style*="display: none"]) input[type=checkbox]').forEach(function(cb){
      cb.checked = true;
    });
  }
});

document.getElementById('btn-desmarcar-todos').addEventListener('click', function(){
  const empVal = document.getElementById('am-emp').value;
  if (!empVal) return;
  const grp = document.querySelector('.am-grp[data-emp="' + empVal + '"]');
  if (grp) {
    grp.querySelectorAll('input[type=checkbox]').forEach(function(cb){
      cb.checked = false;
    });
  }
});

// Filtro rápido de búsqueda
document.getElementById('filtro-personas').addEventListener('input', function(){
  const q = this.value.trim().toLowerCase();
  const empVal = document.getElementById('am-emp').value;
  if (!empVal) return;
  const grp = document.querySelector('.am-grp[data-emp="' + empVal + '"]');
  if (!grp) return;
  grp.querySelectorAll('.item-persona').forEach(function(el){
    const txt = el.dataset.busqueda || '';
    el.style.display = (!q || txt.includes(q)) ? '' : 'none';
  });
});
</script>
