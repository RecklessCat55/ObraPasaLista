node_modules/

# Bases de datos y backups (datos reales de obra: no van al repo)
src/data/*.db
src/data/*.db-wal
src/data/*.db-shm
src/data/backups/*.db
!src/data/.gitkeep
!src/data/backups/.gitkeep

# Entornos virtuales y cachés de Python (legacy) — cualquier ruta, no solo legacy-python/
.venv/
**/.venv/
__pycache__/
**/__pycache__/

# Artefactos de build (PyInstaller)
build/
dist/

# Documentación subida por los usuarios de la app
docs/*
!docs/.gitkeep

*.log
.DS_Store
