{
  "name": "obrapasalista",
  "version": "1.4.1",
  "description": "ObraPasaLista - Control de presencia en obra (puerto a Node.js/Express de la version Python/Flask)",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "node --watch src/app.js",
    "init-db": "node src/cli.js init-db",
    "upgrade-db": "node src/cli.js upgrade-db",
    "backup": "node src/cli.js backup",
    "test": "node tests/smoke_test.js && node tests/http_test.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "multer": "^2.0.0"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
